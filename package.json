{
  "name": "markdown-editor-v1",
  "productName": "Folio",
  "author": "Folio Contributors",
  "version": "1.2.0",
  "description": "Folio · 轻页 — a quiet personal Markdown writing tool.",
  "main": ".webpack/main",
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:prepare": "node scripts/prepare-release.cjs",
    "release:acceptance": "node scripts/release-acceptance.cjs",
    "release:manifest": "node scripts/release-manifest.cjs",
    "release:installer": "node scripts/build-installer.cjs",
    "oss:check": "node scripts/oss-check.cjs",
    "release:lifecycle": "node scripts/installer-lifecycle.cjs",
    "oss:screenshots": "node scripts/oss-screenshots.cjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@electron-forge/plugin-webpack": "^7.8.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@xmldom/xmldom": "^0.9.12",
    "electron": "^35.2.1",
    "ts-loader": "^9.5.2",
    "typescript": "^7.0.2",
    "vitest": "^3.1.3",
    "webpack": "^5.99.8"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.3",
    "fflate": "^0.8.3",
    "image-size": "^2.0.4",
    "katex": "^0.18.10",
    "mathml2omml": "^0.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDEgg-Bing/Folio.git"
  },
  "homepage": "https://github.com/JDEgg-Bing/Folio#readme",
